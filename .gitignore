# No trailing slash: a worktree's node_modules is a symlink, and 'dir/' only matches directories.
node_modules
.env
.env.*
# Evidence lives on the Barkpark task, never in git (decision 0003).
evidence/
*.webm
*.mp4
# Raw oracle pages hold other people's content; fixtures keep numbers only (0001).
fixtures/raw/
.DS_Store
.barkpark/papers/
app/dist/
app/.output/
app/.tanstack/
.cache/
