{
  "name": "barkbot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/transcript-scenes.mjs --check && node scripts/host-enroll-check.mjs",
    "board": "node scripts/board.mjs",
    "docs": "node scripts/generate-hero.mjs && node scripts/generate-roadmap.mjs && node scripts/generate-parity.mjs",
    "hero": "node scripts/generate-hero.mjs",
    "roadmap": "node scripts/generate-roadmap.mjs",
    "parity": "node scripts/generate-parity.mjs",
    "gate": "node scripts/gate.mjs",
    "host": "sh scripts/host.sh run",
    "host:enroll": "sh scripts/host.sh enroll",
    "host:install-agent": "sh scripts/host.sh install-agent",
    "host:uninstall-agent": "sh scripts/host.sh uninstall-agent",
    "host:agent-status": "sh scripts/host.sh agent-status",
    "test:host-agent": "sh scripts/test-host-agent.sh",
    "gate:ci": "node scripts/gate.mjs --ci",
    "gate:b": "node scripts/gate-b.mjs",
    "behaviour": "node scripts/behaviour.mjs",
    "build-check": "node scripts/build-check.mjs",
    "turn:live": "node scripts/turn-live.mjs",
    "land": "sh scripts/land.sh"
  }
}
