{
  "name": "barkbot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/transcript-scenes.mjs --check",
    "board": "node scripts/board.mjs",
    "docs": "node scripts/generate-hero.mjs && node scripts/generate-roadmap.mjs && node scripts/generate-parity.mjs && node scripts/readme-timeline.mjs",
    "hero": "node scripts/generate-hero.mjs",
    "roadmap": "node scripts/generate-roadmap.mjs",
    "parity": "node scripts/generate-parity.mjs",
    "timeline": "node scripts/readme-timeline.mjs",
    "gate": "node scripts/gate.mjs",
    "host": "sh scripts/host.sh run",
    "host:enroll": "sh scripts/host.sh enroll",
    "gate:ci": "node scripts/gate.mjs --ci",
    "gate:b": "node scripts/gate-b.mjs",
    "behaviour": "node scripts/behaviour.mjs",
    "turn:live": "node scripts/turn-live.mjs",
    "land": "sh scripts/land.sh"
